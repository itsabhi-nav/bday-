# Owner login (you, the seller)
OWNER_USER=admin
OWNER_PASS=change-this-password-now

# Session signing key — set a long random string in production!
SESSION_SECRET=please-set-a-long-random-string-here

# Default password given to every new customer (editable per customer too)
# DEFAULT_CUSTOMER_PASSWORD is code-defaulted to 9872 (see lib/auth.ts)

# ── Production database + image storage (Supabase, free tier) ──
# Leave empty for local preview (JSON files in ./data + public/uploads).
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
